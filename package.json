{
  "name": "draw-marcopontili-com",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "description": "Personal whiteboard: Excalidraw with LaTeX (KaTeX), Mermaid-to-shapes, sanitized Markdown, automatic light/dark theme; PNG/JPEG/SVG/PDF export. React + TypeScript + Vite PWA; static, no backend or login.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "assets:brand": "node scripts/render-brand-assets.mjs",
    "brand:images": "node .github/brand/render.mjs",
    "brand:images:check": "node .github/brand/render.mjs --check",
    "readme:shots": "node scripts/readme-shots.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:ci": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "postinstall": "node scripts/ensure-playwright.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:agent-readiness": "node scripts/verify-agent-readiness.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/roboto": "^5.3.0",
    "bootstrap-icons": "^1.13.1",
    "dompurify": "^3.4.16",
    "jspdf": "^4.2.1",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.11.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "sharp": "0.35.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "8.71.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "nanoid": "^5.1.16",
    "uuid": "^14.0.0",
    "esbuild": "^0.25.0",
    "lodash-es": "^4.18.1",
    "serialize-javascript": "^7.0.5",
    "mermaid": "^11.16.1",
    "browserslist": "^4.28.9",
    "baseline-browser-mapping": "^2.11.22",
    "fast-uri": "^3.1.8",
    "js-yaml": "^4.3.2",
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "^5.0.9"
    },
    "@eslint/config-array": {
      "brace-expansion": "1.1.18"
    },
    "@eslint/eslintrc": {
      "brace-expansion": "1.1.18"
    },
    "eslint": {
      "brace-expansion": "1.1.18"
    },
    "filelist": {
      "brace-expansion": "2.1.4"
    },
    "ws": "^8.20.1",
    "sass": "^1.105.1"
  }
}
